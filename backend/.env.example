# YelpCamp Enterprise Backend Environment Configuration
PROJECT_NAME="YelpCamp API"
ENVIRONMENT="development" # Set to "production" in live deployment
SECRET_KEY="generate-a-strong-random-32char-secret-key-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (Local SQLite or Turso Cloud libSQL)
DATABASE_URL="sqlite:///database.db"
USE_TURSO=True
TURSO_DATABASE_URL="https://<your-turso-db-name>.aws-ap-south-1.turso.io"
TURSO_AUTH_TOKEN="your-turso-jwt-auth-token-here"

# Allowed CORS Origins (JSON list or comma-separated)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://ycamp.vercel.app"]

# Local Storage
UPLOAD_DIR="uploads"

# Cloudinary CDN Configuration
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"

# Google OAuth 2.0 Identity Services
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Google Gemini Multi-Modal Embeddings & Flash Agent
GEMINI_API_KEY="your-gemini-api-key-here"
GOOGLE_API_KEY="your-gemini-api-key-here"
EMBEDDING_MODEL="gemini-embedding-2"
CHAT_MODEL="gemini-3.5-flash"
VISION_MODEL="gemini-3.5-flash"

# Redis & Rate Limiting (Optional - falls back to memory limiter if empty)
REDIS_URL="redis://localhost:6379"
RATE_LIMIT_ENABLED=True
